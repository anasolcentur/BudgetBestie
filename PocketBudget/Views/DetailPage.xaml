<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PocketBudget.Views.DetailPage"
    Title="Detalle"
    BackgroundColor="#FFF7FB">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="18">

            <Frame
                Padding="24"
                CornerRadius="28"
                BackgroundColor="#F7B7D2"
                BorderColor="#F49AC2"
                HasShadow="True">

                <VerticalStackLayout Spacing="8">
                    <Label
                        Text="Detalle del gasto 💕"
                        FontSize="28"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"/>

                    <Label
                        Text="Porque cada peso tiene su historia"
                        FontSize="15"
                        TextColor="#FFF7FB"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

            </Frame>

            <Frame
                Padding="22"
                CornerRadius="26"
                BackgroundColor="White"
                BorderColor="#FFC8DD"
                HasShadow="True">

                <VerticalStackLayout Spacing="16">

                    <Label
                        Text="📝 Descripción"
                        FontAttributes="Bold"
                        TextColor="#B85C8E"/>

                    <Label
                        Text="{Binding Description}"
                        FontSize="23"
                        FontAttributes="Bold"
                        TextColor="#7A4E69"/>

                    <BoxView
                        HeightRequest="1"
                        BackgroundColor="#FFE5EC"/>

                    <Label
                        Text="📂 Categoría"
                        FontAttributes="Bold"
                        TextColor="#B85C8E"/>

                    <Label
                        Text="{Binding Category}"
                        FontSize="18"
                        TextColor="#7A4E69"/>

                    <BoxView
                        HeightRequest="1"
                        BackgroundColor="#FFE5EC"/>

                    <Label
                        Text="💲 Monto"
                        FontAttributes="Bold"
                        TextColor="#B85C8E"/>

                    <Label
                        Text="{Binding Amount, StringFormat='${0:F2}'}"
                        FontSize="28"
                        FontAttributes="Bold"
                        TextColor="#FF5D8F"/>

                    <BoxView
                        HeightRequest="1"
                        BackgroundColor="#FFE5EC"/>

                    <Label
                        Text="📅 Fecha"
                        FontAttributes="Bold"
                        TextColor="#B85C8E"/>

                    <Label
                        Text="{Binding Date, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                        FontSize="16"
                        TextColor="#7A4E69"/>

                    <BoxView
                        HeightRequest="1"
                        BackgroundColor="#FFE5EC"/>

                    <Label
                        Text="🧾 Ticket"
                        FontAttributes="Bold"
                        TextColor="#B85C8E"/>

                    <Label
                        Text="{Binding ReceiptStatusMessage}"
                        FontSize="15"
                        TextColor="#7A4E69"/>

                    <Image
                        Source="{Binding ReceiptImagePath}"
                        IsVisible="{Binding HasReceiptImage}"
                        HeightRequest="260"
                        Aspect="AspectFit"
                        BackgroundColor="#FFF0F5"/>

                </VerticalStackLayout>

            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>