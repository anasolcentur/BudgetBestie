<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PocketBudget.Views.MainPage"
    Title="Budget Bestie"
    BackgroundColor="#FFF7FB">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="18">

            <Frame
                Padding="24"
                CornerRadius="28"
                BackgroundColor="#F7B7D2"
                BorderColor="#F49AC2"
                HasShadow="True">

                <VerticalStackLayout Spacing="8">
                    <Label
                        Text="Budget Bestie 💕"
                        FontSize="31"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"/>

                    <Label
                        Text="Tu mejor amiga para controlar gastos"
                        FontSize="15"
                        TextColor="#FFF7FB"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

            </Frame>

            <Button
                Text="✨ Cargar categorías desde API"
                Command="{Binding LoadCategoriesCommand}"
                BackgroundColor="#CDB4DB"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="20"
                HeightRequest="50"/>

            <Frame
                Padding="13"
                CornerRadius="18"
                BackgroundColor="#FFE5EC"
                BorderColor="#FFB3C6">

                <Label
                    Text="{Binding StatusMessage}"
                    FontSize="14"
                    TextColor="#7A4E69"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"/>

            </Frame>

            <Frame
                Padding="20"
                CornerRadius="26"
                BackgroundColor="White"
                BorderColor="#FFC8DD"
                HasShadow="True">

                <VerticalStackLayout Spacing="14">

                    <Label
                        Text="Nuevo gastito 🛍️"
                        FontSize="24"
                        FontAttributes="Bold"
                        TextColor="#B85C8E"
                        HorizontalOptions="Center"/>

                    <BoxView
                        HeightRequest="1"
                        BackgroundColor="#FFE5EC"/>

                    <Label
                        Text="📝 Descripción"
                        FontAttributes="Bold"
                        FontSize="15"
                        TextColor="#9D4E77"/>

                    <Entry
                        Placeholder="Ej: café, ropa, súper..."
                        Text="{Binding ExpenseDescription}"
                        BackgroundColor="#FFF0F5"
                        TextColor="#5C3A4D"
                        PlaceholderColor="#B5839D"/>

                    <Label
                        Text="💲 Monto"
                        FontAttributes="Bold"
                        FontSize="15"
                        TextColor="#9D4E77"/>

                    <Entry
                        Placeholder="Ej: 1500"
                        Keyboard="Numeric"
                        Text="{Binding ExpenseAmount}"
                        BackgroundColor="#FFF0F5"
                        TextColor="#5C3A4D"
                        PlaceholderColor="#B5839D"/>

                    <Label
                        Text="📂 Categoría"
                        FontAttributes="Bold"
                        FontSize="15"
                        TextColor="#9D4E77"/>

                    <Picker
                        Title="Elegí una categoría"
                        ItemsSource="{Binding Categories}"
                        ItemDisplayBinding="{Binding Name}"
                        SelectedItem="{Binding SelectedCategory}"
                        BackgroundColor="#FFF0F5"
                        TextColor="#5C3A4D"
                        TitleColor="#B5839D"/>

                    <Button
                        Text="Agregar gasto 💖"
                        Command="{Binding AddExpenseCommand}"
                        BackgroundColor="#FF8FAB"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="20"
                        HeightRequest="50"/>

                </VerticalStackLayout>

            </Frame>

            <BoxView
                HeightRequest="1"
                BackgroundColor="#FFC8DD"
                Margin="0,4"/>

            <Label
                Text="Mis gastos ✨"
                FontAttributes="Bold"
                FontSize="24"
                TextColor="#B85C8E"/>

            <CollectionView
                ItemsSource="{Binding Expenses}">

                <CollectionView.EmptyView>
                    <Frame
                        Padding="18"
                        CornerRadius="22"
                        BackgroundColor="#FFE5EC"
                        BorderColor="#FFC8DD"
                        Margin="0,10">

                        <Label
                            Text="Todavía no hay gastos cargados. Tu billetera respira tranquila... por ahora."
                            FontSize="15"
                            TextColor="#7A4E69"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"/>
                    </Frame>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Frame
                            Margin="0,7"
                            Padding="16"
                            CornerRadius="22"
                            BackgroundColor="White"
                            BorderColor="#FFC8DD"
                            HasShadow="True">

                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.GoToDetailCommand}"
                                    CommandParameter="{Binding .}" />
                            </Frame.GestureRecognizers>

                            <VerticalStackLayout Spacing="8">

                                <Grid
                                    ColumnDefinitions="*,Auto"
                                    RowDefinitions="Auto">

                                    <Label
                                        Grid.Column="0"
                                        Text="{Binding Description}"
                                        FontAttributes="Bold"
                                        FontSize="19"
                                        TextColor="#9D4E77"/>

                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding Amount, StringFormat='${0:F2}'}"
                                        FontAttributes="Bold"
                                        FontSize="18"
                                        TextColor="#FF5D8F"
                                        VerticalOptions="Center"/>
                                </Grid>

                                <Label
                                    Text="{Binding Category}"
                                    FontSize="15"
                                    TextColor="#B5839D"/>

                                <Label
                                    Text="{Binding Date, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                    FontSize="12"
                                    TextColor="#A8A0A5"/>

                                <BoxView
                                    HeightRequest="1"
                                    BackgroundColor="#FFE5EC"/>

                                <Label
                                    Text="Tocá para ver el detalle"
                                    FontSize="12"
                                    TextColor="#C77DA5"
                                    HorizontalOptions="End"/>

                            </VerticalStackLayout>

                        </Frame>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>